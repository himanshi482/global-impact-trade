+        rejectUnauthorized: Boolean(process.env.DB_SSL_CA),
+        ...(process.env.DB_SSL_CA ? { ca: process.env.DB_SSL_CA } : {}),
+      }
+    : undefined;
+
   return mysql.createPool({
