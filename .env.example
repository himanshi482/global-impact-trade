# Copy this file to .env and fill in real values.
# Never commit .env — it's already in .gitignore.

# MySQL connection (used by lib/db.js and db/migrate.js).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=globebridge

# Set to true for managed MySQL providers that require SSL (Aiven, Clever
# Cloud, PlanetScale, etc.) — without this, every DB query fails and every
# route touching the database (register, login, ...) returns a generic 500.
# If your provider gives you a CA certificate, paste its full contents
# (including the -----BEGIN CERTIFICATE----- lines) into DB_SSL_CA for a
# verified connection; otherwise the connection is still encrypted but
# unverified.
DB_SSL=false
DB_SSL_CA=

# Secret used to sign session tokens (Phase 4). Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Outgoing email (password reset, OTP, verification — Phase 4).
# Leave blank in local development: emails/OTPs will be logged to the
# server console instead of actually being sent.
EMAIL_SERVER=
EMAIL_FROM=

# Public base URL of the app, used in emailed links (e.g. password reset).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Trade data source. External mode requires a real configured provider.
TRADE_DATA_PROVIDER=database
TRADE_API_BASE_URL=
TRADE_API_KEY=

# Set true only when the deployment proxy overwrites forwarded client headers.
TRUST_PROXY=false
ALERT_CRON_SECRET=
